<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Desabilita Impeller no build de debug — o emulador Android (OpenGLES)
             reporta "Width is zero. 0,0" com Impeller ativo, resultando em tela preta.
             Em builds de release o Impeller permanece ativo (melhor performance). -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
