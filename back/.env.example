# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@aws-1-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require"

# ── Supabase Auth ─────────────────────────────────────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # Supabase → Settings → API → service_role

# ── Redis (Upstash) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# ── LLM — Anthropic ───────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── LLM — Maritaca AI (Sabiá-4) ──────────────────────────
MARITACA_API_KEY="..."
MARITACA_BASE_URL="https://chat.maritaca.ai/api"

# ── RevenueCat ────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET="rchk_..."

# ── OneSignal ─────────────────────────────────────────────
ONESIGNAL_APP_ID="..."
ONESIGNAL_API_KEY="..."

# ── Sentry ────────────────────────────────────────────────
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# ── App ───────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"
LOG_LEVEL="info"
# CORS: origens permitidas em produção (separadas por vírgula). Omitir = aceita todas.
CORS_ORIGIN="https://app.lcf.com.br,https://lcf.com.br"

# ── Rate Limits ───────────────────────────────────────────
TUTOR_RATE_FREE=20
TUTOR_RATE_PRO=200
